{
  "expo": {
    "name": "JATT",
    "slug": "jatt-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["**/*"],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b0e14"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.peterjokumsen.jatt",
      "icon": "./assets/icon.png"
    },
    "android": {
      "package": "com.peterjokumsen.jatt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#a855f7"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
