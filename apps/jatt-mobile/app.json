    "android": {
      "package": "com.peterjokumsen.jatt",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.jpg",
        "backgroundColor": "#a855f7"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
