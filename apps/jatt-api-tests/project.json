{
  "name": "jatt-api-tests",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/jatt-api-tests",
  "targets": {
    "publish": {},
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "dotnet test",
        "cwd": "apps/jatt-api-tests"
      },
      "configurations": {
        "ci": {
          "command": "dotnet test --collect:\"XPlat Code Coverage\" --results-directory ../../coverage/apps/jatt-api-tests"
        }
      }
    }
  }
}
